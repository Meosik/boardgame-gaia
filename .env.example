# Copy to .env (gitignored) and fill in real values before `docker compose up`.

# Postgres password used by both the `postgres` and `gaia-server` services.
POSTGRES_PASSWORD=

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels ->
# create tunnel -> copy the token from the install command it shows you).
CLOUDFLARE_TUNNEL_TOKEN=

# Shared passphrase gating every route behind the tunnel. Leave blank to
# disable the gate (open to anyone with the link). Hand the value out to
# invited players yourself — it's not tied to any individual identity.
GAIA_SITE_PASSWORD=
