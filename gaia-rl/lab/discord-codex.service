# systemd user service for the Codex Discord bot (second model as its own bot; see lab/README.md).
[Unit]
Description=Discord bot that runs Codex (read-only) next to the Claude bot for gaia
After=network-online.target

[Service]
WorkingDirectory=%h/projects/gaia-work/gaia-rl/lab
EnvironmentFile=%h/projects/gaia-work/gaia-rl/lab/discord_claude.env
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.venvs/gaia-claude-bot/bin/python discord_codex.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
