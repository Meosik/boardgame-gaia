# Copy to lab/discord_claude.env (git-ignored). Never commit the token.
DISCORD_BOT_TOKEN=
# Your Discord user ID (Developer Mode → right-click yourself → Copy User ID)
DISCORD_OWNER_ID=
# The #claude channel ID(s), comma-separated (DMs from the owner always work)
DISCORD_CHANNEL_IDS=
GAIA_WORKDIR=/home/sohegi/projects/gaia-work
CLAUDE_TURN_MINUTES=30
# 채널 대화를 이 턴 수에서 끊고 새 대화로(토큰 절약); `!q` 일회성 답에 쓰는 모델
CLAUDE_SESSION_TURNS=10
CLAUDE_QUICK_MODEL=claude-sonnet-5-5
# 1이면 봇 턴에도 계정의 MCP 서버(Notion·Docs·Drive 커넥터)를 싣는다(기본: 싣지 않음, 토큰 절약)
# CLAUDE_BOT_MCP=1
# Monitoring channel where lab's webhook posts; a ✅ result there starts an automatic review
DISCORD_LAB_CHANNEL_ID=
# Optional: only this webhook's posts trigger reviews (webhook URL .../webhooks/<ID>/<token>)
DISCORD_LAB_WEBHOOK_ID=
