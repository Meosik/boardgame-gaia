# agentmaco (multi-ai) bot environment — copy to ~/.config/gaia/discord-agentmaco.env (chmod 600), outside any work tree.
# The token is the existing multi-ai bot's DISCORD_BOT_TOKEN (~/projects/multi-ai/.env); the bot code never reads that file.
DISCORD_BOT_TOKEN=
# Owner and channel: the values of ~/projects/multi-ai/.env.example (owner id, multi-ai channel id)
DISCORD_OWNER_ID=335667049839853568
DISCORD_CHANNEL_IDS=1554144240127442945
# This instance answers its channel only: the gaia bots own the owner's DMs
DISCORD_ALLOW_DM=0
# No lab webhook here (left empty: a lab notice must not open a turn in this bot)
DISCORD_LAB_CHANNEL_ID=
DISCORD_LAB_WEBHOOK_ID=
# No Codex Discord bot in this channel: review is scripts/review.sh inside the turn
DEBATE_ROUNDS=0
CODEX_BOT_ID=
# Project, state, prompt, allow list, context index, attachments
GAIA_WORKDIR=/home/sohegi/projects/multi-ai
GAIA_BOT_STATE=/home/sohegi/.agentmaco-claude-bot.json
CLAUDE_BOT_SYSTEM_FILE=/home/sohegi/projects/gaia-work/gaia-rl/lab/agentmaco/system.md
CLAUDE_BOT_SETTINGS=/home/sohegi/projects/gaia-work/gaia-rl/lab/agentmaco/claude-bot-settings.json
CLAUDE_BOT_FRESH_CONTEXT=.workflow/STATUS.md
CLAUDE_BOT_INBOX=/home/sohegi/projects/multi-ai/.workflow/inbox
# Models and limits (same defaults as the gaia bot)
CLAUDE_MODEL=claude-fable-5-1
CLAUDE_QUICK_MODEL=claude-sonnet-5-5
CLAUDE_SESSION_TURNS=10
CLAUDE_TURN_MINUTES=30
